<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.heartnetapps.files">

    <!-- to see and change everything on the phone's storage -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- so an APK tapped in the list can be handed to the installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Files"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="dev.heartnetapps.files.FilesActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode|density|smallestScreenSize|navigation|keyboard"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="files" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="dev.heartnetapps.files.ShareProvider"
            android:authorities="dev.heartnetapps.files.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
